# Copy to .env for local testing (Render uses its own env var UI instead).

# From @BotFather. The bot must be added to the group (and, for live indexing,
# have its privacy mode disabled via /setprivacy -> Disable).
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Optional. API root; leave as-is for the cloud Bot API.
TELEGRAM_API_BASE=https://api.telegram.org

# Makes state durable (groups, file index, settings survive restarts).
# A classic token with the `gist` scope. Also used for optional repo storage.
GITHUB_TOKEN=
# STATE_GIST_ID=
# STATE_REPO=owner/repo
# STATE_PATH=bonki-intel-state.json

# Public URL of this app, so the Telegram webhook can be registered on boot.
# On Render this is set for you (RENDER_EXTERNAL_URL); elsewhere set it here.
WEBHOOK_BASE=

# How Bonki receives updates:
#   1 = long polling (default when there's no public URL; best on hosts that
#       sleep, e.g. Render free - Telegram queues updates and they arrive on wake)
#   0 = webhook (needs WEBHOOK_BASE / RENDER_EXTERNAL_URL)
# Leave unset to auto-choose (webhook if a public URL exists, else polling).
USE_POLLING=
# Only needed for webhook mode; one is generated automatically if you leave it blank.
WEBHOOK_SECRET=

# --- the brain (also settable in the dashboard) ---
# gemini | openai | off
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- user account (MTProto), for scanning group history ---
# From https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Full login for your account, from userbot_login.py. Treat like a password.
TG_SESSION=
